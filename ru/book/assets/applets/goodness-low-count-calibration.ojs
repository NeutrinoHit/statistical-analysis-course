viewof cowanObs = Inputs.range([0, 60], {value: 29.8, step: 0.1, label: "Значение T_obs"})

cowanNuModel = [
  0.158, 0.295, 0.513, 0.833, 1.263,
  1.785, 2.355, 2.899, 3.330, 3.568,
  3.568, 3.330, 2.899, 2.355, 1.785,
  1.263, 0.833, 0.513, 0.295, 0.158
]

cowanRandomFactory = () => {
  let state = 123456789;
  return () => {
    state = (1664525 * state + 1013904223) >>> 0;
    return state / 4294967296;
  };
}

cowanPoisson = (lambda, rand) => {
  const l = Math.exp(-lambda);
  let k = 0;
  let p = 1;
  do {
    k += 1;
    p *= rand();
  } while (p > l);
  return k - 1;
}

cowanToyStats = {
  const rand = cowanRandomFactory();
  const out = [];
  const bCount = 80000;
  for (let b = 0; b < bCount; b++) {
    let t = 0;
    for (const mu of cowanNuModel) {
      const n = cowanPoisson(mu, rand);
      const d = n - mu;
      t += d * d / mu;
    }
    out.push(t);
  }
  return out;
}

cowanHistogram = {
  const binWidth = 1;
  const bins = Array.from({length: 60}, () => 0);
  for (const t of cowanToyStats) {
    if (t >= 0 && t < 60) bins[Math.floor(t / binWidth)] += 1;
  }
  return bins.map((n, i) => ({
    x1: i * binWidth,
    x2: (i + 1) * binWidth,
    y: n / (cowanToyStats.length * binWidth)
  }));
}

cowanChi2Data = Array.from({length: 1200}, (_, i) => {
  const x = 1e-4 + 60 * i / 1199;
  return {x, y: chiDistPdf(x, 20)};
})

cowanChi2Tail = chiDistSf(cowanObs, 20)

cowanModelP = cowanToyStats.filter(t => t >= cowanObs).length / cowanToyStats.length;
cowanModelError = Math.sqrt(cowanModelP * (1 - cowanModelP) / cowanToyStats.length)
cowanExceedances = cowanToyStats.filter(t => t >= cowanObs).length

cowanPlot = Plot.plot({
  width: 760,
  height: 340,
  marginLeft: 58,
  marginBottom: 48,
  style: {fontSize: "14px"},
  x: {label: "T", domain: [0, 60], grid: true},
  y: {label: "плотность", domain: [0, 0.10], grid: true},
  marks: [
    Plot.rectY(cowanHistogram, {
      x1: "x1",
      x2: "x2",
      y: "y",
      fill: "#8d9ea8",
      fillOpacity: 0.62
    }),
    Plot.line(cowanChi2Data, {
      x: "x",
      y: "y",
      stroke: "#367ab5",
      strokeWidth: 2.5,
      strokeDasharray: "6,4"
    }),
    Plot.ruleX([cowanObs], {stroke: "#c44536", strokeWidth: 2}),
    Plot.text([{x: Math.min(cowanObs + 5, 52), y: 0.075, label: "T_obs"}],
      {x: "x", y: "y", text: "label", fill: "#263640", fontSize: 14})
  ]
})

html`
<div class="book-applet-panel">
  <div class="book-applet-center">${cowanPlot}</div>
  <div class="book-applet-summary">
    <span>80 000 опытов; 20 независимых бинов</span>
    <span>T_obs = ${cowanObs.toFixed(1)}</span>
    <span>Превышений: ${cowanExceedances}</span>
    <span>p из опытов = ${chiDistProbabilityText(cowanModelP)}; ошибка ≈ ${cowanModelError.toFixed(5)}</span>
    <span>p по χ²₂₀ = ${chiDistProbabilityText(cowanChi2Tail)}</span>
  </div>
  <p>Гистограмма — псевдоэксперименты; синий пунктир — χ²₂₀. Нормировка учитывает все опыты, в том числе T ≥ 60.</p>
</div>`
