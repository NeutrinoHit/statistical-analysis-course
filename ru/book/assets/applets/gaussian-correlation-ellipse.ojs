viewof rhoEllipse = Inputs.range([-0.98, 0.98], {
  value: 0.65,
  step: 0.01,
  label: "Корреляция ρ"
})

viewof sigmaXEllipse = Inputs.range([0.4, 2.2], {
  value: 1.4,
  step: 0.05,
  label: "Ширина σ_X"
})

viewof sigmaYEllipse = Inputs.range([0.4, 2.2], {
  value: 0.8,
  step: 0.05,
  label: "Ширина σ_Y"
})

viewof regenerateEllipse = Inputs.button("Новое облако", {
  value: 0,
  reduce: value => value + 1
})

seededUniformCh7 = seed => {
  let state = seed >>> 0;
  return () => {
    state = (state + 0x6D2B79F5) >>> 0;
    let value = state;
    value = Math.imul(value ^ (value >>> 15), value | 1);
    value ^= value + Math.imul(value ^ (value >>> 7), value | 61);
    return ((value ^ (value >>> 14)) >>> 0) / 4294967296;
  };
}

randnEllipse = random => {
  const u1 = Math.max(random(), 1e-12);
  const u2 = random();
  return Math.sqrt(-2 * Math.log(u1)) * Math.cos(2 * Math.PI * u2);
}

ellipseSeed = (
  20260906
  + 1009 * regenerateEllipse
  + 37 * Math.round((rhoEllipse + 1) * 1000)
  + 101 * Math.round(sigmaXEllipse * 100)
  + 211 * Math.round(sigmaYEllipse * 100)
) >>> 0

ellipseCloud = {
  const random = seededUniformCh7(ellipseSeed);
  const points = [];
  const residualScale = Math.sqrt(1 - rhoEllipse * rhoEllipse);
  for (let i = 0; i < 1200; ++i) {
    const z1 = randnEllipse(random);
    const z2 = randnEllipse(random);
    points.push({
      x: sigmaXEllipse * z1,
      y: sigmaYEllipse * (rhoEllipse * z1 + residualScale * z2)
    });
  }
  return points;
}

ellipseContour = {
  const radius = Math.sqrt(2.30);
  const residualScale = Math.sqrt(1 - rhoEllipse * rhoEllipse);
  return Array.from({length: 241}, (_, i) => {
    const angle = 2 * Math.PI * i / 240;
    const z1 = radius * Math.cos(angle);
    const z2 = radius * Math.sin(angle);
    return {
      x: sigmaXEllipse * z1,
      y: sigmaYEllipse * (rhoEllipse * z1 + residualScale * z2)
    };
  });
}

ellipseExtentX = 3.5 * sigmaXEllipse
ellipseExtentY = 3.5 * sigmaYEllipse

ellipsePlot = Plot.plot({
  width: 700,
  aspectRatio: 1,
  marginLeft: 62,
  x: {label: "X", domain: [-ellipseExtentX, ellipseExtentX], grid: true},
  y: {label: "Y", domain: [-ellipseExtentY, ellipseExtentY], grid: true},
  marks: [
    Plot.frame(),
    Plot.ruleX([0], {stroke: "#777"}),
    Plot.ruleY([0], {stroke: "#777"}),
    Plot.dot(ellipseCloud, {
      x: "x",
      y: "y",
      r: 2.1,
      fill: "#4ea1ff",
      fillOpacity: 0.34
    }),
    Plot.line(ellipseContour, {
      x: "x",
      y: "y",
      stroke: "#ff8c42",
      strokeWidth: 3.5
    })
  ]
})

html`
<div class="book-applet-panel">
  ${ellipsePlot}
  <div class="book-applet-summary">
    <span>ρ = ${rhoEllipse.toFixed(2)};</span>
    <span>σ_X = ${sigmaXEllipse.toFixed(2)};</span>
    <span>σ_Y = ${sigmaYEllipse.toFixed(2)};</span>
    <span>линия: D² = 2.30, внутри 68.3% распределения.</span>
  </div>
</div>
`
