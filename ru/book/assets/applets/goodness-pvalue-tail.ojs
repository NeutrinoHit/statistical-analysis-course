viewof pLevelNu = Inputs.range([1, 120], {value: 50, step: 1, label: "Степени свободы ν"})
viewof pLevelObs = Inputs.range([0, 180], {value: 70, step: 0.5, label: "Значение t_obs"})
pLevelXmax = Math.max(12, pLevelObs + 5, pLevelNu + 6 * Math.sqrt(2 * pLevelNu))
pLevelData = chiDistGrid(pLevelNu, pLevelXmax)
pLevelTailData = [{t: Math.max(pLevelObs, 1e-8), density: chiDistPdf(Math.max(pLevelObs, 1e-8), pLevelNu)},
  ...pLevelData.filter(d => d.t > pLevelObs)]
pLevelTailArea = chiDistSf(pLevelObs, pLevelNu)
pLevelPlot = Plot.plot({
  width: 760, height: 340, marginLeft: 58, marginBottom: 48,
  style: {fontSize: "14px"},
  x: {label: "t", domain: [0, pLevelXmax], grid: true},
  y: {label: "f(t; ν)", domain: [0, chiDistPlotLimit(pLevelNu)], grid: true},
  marks: [
    Plot.areaY(pLevelTailData, {x: "t", y: "density", fill: "#c44536", fillOpacity: 0.35, clip: true}),
    Plot.line(pLevelData, {x: "t", y: "density", stroke: "#367ab5", strokeWidth: 2.5, clip: true}),
    Plot.ruleX([pLevelObs], {stroke: "#c44536", strokeWidth: 2})
  ]
})
html`<div class="book-applet-panel">
  ${pLevelPlot}
  <div class="book-applet-summary">
    <span>ν = ${pLevelNu}</span>
    <span>t_obs = ${pLevelObs.toFixed(1)}</span>
    <span>p = ${chiDistProbabilityText(pLevelTailArea)}</span>
    <span>${pLevelNu === 1 ? "Плотность у нуля обрезана сверху. Вероятность вычислена по полному хвосту." : ""}</span>
  </div>
</div>`
