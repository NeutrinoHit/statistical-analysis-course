viewof chiOneSigma = Inputs.range([0.3, 2], {value: 1, step: 0.1, label: "Ошибка σθ"})
viewof chiOneCut = Inputs.range([0.25, 4], {value: 1, step: 0.25, label: "Уровень c"})
chiOneExtent = Math.max(2.5, 1.25 * Math.sqrt(chiOneCut) * chiOneSigma)
chiOneBoundary = Math.sqrt(chiOneCut) * chiOneSigma
chiOneData = Array.from({length: 401}, (_, i) => {
  const delta = -chiOneExtent + 2 * chiOneExtent * i / 400;
  return {delta, q: (delta / chiOneSigma) ** 2};
})
chiOneMarks = [
  {delta: -chiOneBoundary, q: chiOneCut},
  {delta: chiOneBoundary, q: chiOneCut}
]
chiOnePlot = Plot.plot({
  width: 760, height: 340, marginLeft: 58, marginBottom: 48, marginRight: 24,
  style: {fontSize: "14px"},
  x: {label: "θ − θ̂", domain: [-chiOneExtent, chiOneExtent], grid: true},
  y: {label: "Δχ²", domain: [0, Math.max(5, 1.4 * chiOneCut)], grid: true},
  marks: [
    Plot.ruleY([chiOneCut], {stroke: "#c44536", strokeDasharray: "6,4"}),
    Plot.ruleX([-chiOneBoundary, chiOneBoundary], {y1: 0, y2: chiOneCut,
      stroke: "#c44536", strokeDasharray: "6,4"}),
    Plot.line(chiOneData, {x: "delta", y: "q", stroke: "#367ab5", strokeWidth: 2.5, clip: true}),
    Plot.dot(chiOneMarks, {x: "delta", y: "q", r: 5, fill: "#c44536"}),
    Plot.dot([{delta: 0, q: 0}], {x: "delta", y: "q", r: 5, fill: "#263640"})
  ]
})
html`<div class="book-applet-panel">
  ${chiOnePlot}
  <div class="book-applet-summary">
    <span>σθ = ${chiOneSigma.toFixed(2)}</span>
    <span>c = ${chiOneCut.toFixed(2)}</span>
    <span>Границы θ − θ̂: ±${chiOneBoundary.toFixed(3)}</span>
  </div>
</div>`
