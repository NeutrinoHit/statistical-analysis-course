viewof likeN = Inputs.range([1, 200], {
  value: 20,
  step: 1,
  label: "число частиц N"
})

viewof likeK = Inputs.range([0, likeN], {
  value: Math.round(0.35 * likeN),
  step: 1,
  label: "число срабатываний k"
})

likeEpsilonGrid = Array.from({length: 501}, (_, i) => i / 500)

likeEpsilonHat = likeK / likeN

likeLogLikelihood = epsilon => {
  if (epsilon === 0) return likeK === 0 ? 0 : -Infinity
  if (epsilon === 1) return likeK === likeN ? 0 : -Infinity
  return likeK * Math.log(epsilon)
    + (likeN - likeK) * Math.log(1 - epsilon)
}

likeLogMaximum = likeLogLikelihood(likeEpsilonHat)

likeCurve = likeEpsilonGrid.map(epsilon => ({
  epsilon,
  relative: Math.exp(likeLogLikelihood(epsilon) - likeLogMaximum)
}))

likeStandardError = Math.sqrt(
  likeEpsilonHat * (1 - likeEpsilonHat) / likeN
)

likePlot = Plot.plot({
  width: 940,
  height: 430,
  marginLeft: 70,
  x: {
    label: "эффективность ε",
    domain: [0, 1],
    grid: true
  },
  y: {
    label: "L(ε) / L(ε̂)",
    domain: [0, 1.05],
    grid: true
  },
  marks: [
    Plot.line(likeCurve, {
      x: "epsilon",
      y: "relative",
      stroke: "#4ea1ff",
      strokeWidth: 4
    }),
    Plot.ruleX([likeEpsilonHat], {
      stroke: "#ff8c42",
      strokeWidth: 4
    })
  ]
})

html`
<div class="book-applet-panel">
  ${likePlot}
  <div class="book-applet-summary">
    <span>N = ${likeN}, k = ${likeK}</span>
    <span>оценка эффективности ε̂ = k/N = ${likeEpsilonHat.toFixed(3)}</span>
    <span>оценка стандартной ошибки = ${likeStandardError.toFixed(3)}</span>
  </div>
</div>
`
