viewof twoSideGaussZ = Inputs.range([0, 6], {value: 2, step: 0.1, label: "Граница |G|: Z"})
twoSideGaussPdf = g => Math.exp(-g*g/2)/Math.sqrt(2*Math.PI)
twoSideGaussP = chiDistSf(twoSideGaussZ**2,1)
twoSideGaussXmax = Math.max(4.5, twoSideGaussZ+1)
twoSideGaussData = Array.from({length:1201},(_,i)=>{
  const g = -twoSideGaussXmax + 2*twoSideGaussXmax*i/1200;
  return {g, density:twoSideGaussPdf(g)};
})
twoSideGaussRight = [{g:twoSideGaussZ,density:twoSideGaussPdf(twoSideGaussZ)},...twoSideGaussData.filter(d=>d.g>twoSideGaussZ)]
twoSideGaussLeft = [...twoSideGaussData.filter(d=>d.g<-twoSideGaussZ),{g:-twoSideGaussZ,density:twoSideGaussPdf(twoSideGaussZ)}]
twoSideGaussPlot = Plot.plot({
  width:760,height:340,marginLeft:58,marginBottom:48,
  style:{fontSize:"14px"},
  x:{label:"g",domain:[-twoSideGaussXmax,twoSideGaussXmax],grid:true},
  y:{label:"φ(g)",domain:[0,0.43],grid:true},
  marks:[
    Plot.areaY(twoSideGaussRight,{x:"g",y:"density",fill:"#c44536",fillOpacity:0.4}),
    Plot.areaY(twoSideGaussLeft,{x:"g",y:"density",fill:"#c44536",fillOpacity:0.4}),
    Plot.line(twoSideGaussData,{x:"g",y:"density",stroke:"#367ab5",strokeWidth:2.5}),
    Plot.ruleX([-twoSideGaussZ,twoSideGaussZ],{stroke:"#c44536",strokeWidth:2})
  ]
})
html`<div class="book-applet-panel">
  ${twoSideGaussPlot}
  <div class="book-applet-summary">
    <span>Z = ${twoSideGaussZ.toFixed(1)}</span>
    <span>p = P(|G| ≥ Z) = ${chiDistProbabilityText(twoSideGaussP)}</span>
    <span>Каждый хвост: ${chiDistProbabilityText(twoSideGaussP/2)}</span>
  </div>
</div>`
