viewof oneSideGaussZ = Inputs.range([-3, 6], {value: 2, step: 0.1, label: "Граница G: Z"})
oneSideGaussPdf = g => Math.exp(-g*g/2)/Math.sqrt(2*Math.PI)
oneSideGaussP = oneSideGaussZ >= 0 ? 0.5*chiDistSf(oneSideGaussZ**2,1) : 1-0.5*chiDistSf(oneSideGaussZ**2,1)
oneSideGaussXmax = Math.max(4.5, oneSideGaussZ+1)
oneSideGaussData = Array.from({length:1201},(_,i)=>{
  const g = -oneSideGaussXmax + 2*oneSideGaussXmax*i/1200;
  return {g, density:oneSideGaussPdf(g)};
})
oneSideGaussRight = [{g:oneSideGaussZ,density:oneSideGaussPdf(oneSideGaussZ)},...oneSideGaussData.filter(d=>d.g>oneSideGaussZ)]

oneSideGaussPlot = Plot.plot({
  width:760,height:340,marginLeft:58,marginBottom:48,
  style:{fontSize:"14px"},
  x:{label:"g",domain:[-oneSideGaussXmax,oneSideGaussXmax],grid:true},
  y:{label:"φ(g)",domain:[0,0.43],grid:true},
  marks:[
    Plot.areaY(oneSideGaussRight,{x:"g",y:"density",fill:"#c44536",fillOpacity:0.4}),

    Plot.line(oneSideGaussData,{x:"g",y:"density",stroke:"#367ab5",strokeWidth:2.5}),
    Plot.ruleX([oneSideGaussZ],{stroke:"#c44536",strokeWidth:2})
  ]
})
html`<div class="book-applet-panel">
  ${oneSideGaussPlot}
  <div class="book-applet-summary">
    <span>Z = ${oneSideGaussZ.toFixed(1)}</span>
    <span>p = P(G ≥ Z) = ${chiDistProbabilityText(oneSideGaussP)}</span>

  </div>
</div>`
