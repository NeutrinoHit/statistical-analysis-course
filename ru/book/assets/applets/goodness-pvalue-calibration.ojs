viewof pUniformCount = Inputs.range([500, 20000], {value: 5000, step: 500, label: "Число проверяемых опытов"})
pUniformRandomFactory = () => {
  let state = 246813579;
  return () => {state = (1664525 * state + 1013904223) >>> 0; return state / 4294967296;};
}
pUniformNormal = rand => Math.sqrt(-2 * Math.log(Math.max(rand(), 1e-12))) * Math.cos(2 * Math.PI * rand())
pUniformChi2Sample = (count, nu, rand) => Array.from({length: count}, () => {
  let sum = 0;
  for (let i = 0; i < nu; i++) sum += pUniformNormal(rand) ** 2;
  return sum;
})
pUniformSamples = {
  const rand = pUniformRandomFactory();
  return {calibration: pUniformChi2Sample(20000, 10, rand).sort((a,b) => a-b),
    observed: pUniformChi2Sample(20000, 10, rand)};
}
pUniformLowerBound = (values, t) => {
  let lo = 0, hi = values.length;
  while (lo < hi) {
    const mid = Math.floor((lo + hi) / 2);
    if (values[mid] < t) lo = mid + 1;
    else hi = mid;
  }
  return lo;
}
pUniformAllValues = pUniformSamples.observed.map(t => {
  const values = pUniformSamples.calibration, b = values.length;
  return (b - pUniformLowerBound(values, t) + 1) / (b + 1);
})
pUniformValues = pUniformAllValues.slice(0, pUniformCount)
pUniformHistogram = {
  const bins = new Array(20).fill(0);
  for (const p of pUniformValues) bins[Math.min(19, Math.floor(20 * p))]++;
  return bins.map((n, i) => ({x1:i/20, x2:(i+1)/20, density:20*n/pUniformCount}));
}
pUniformPlot = Plot.plot({
  width:760, height:340, marginLeft:58, marginBottom:48,
  style:{fontSize:"14px"},
  x:{label:"p",domain:[0,1],grid:true},
  y:{label:"плотность",domain:[0,Math.max(1.45,1.12*Math.max(...pUniformHistogram.map(d=>d.density)))],grid:true},
  marks:[
    Plot.rectY(pUniformHistogram,{x1:"x1",x2:"x2",y:"density",fill:"#367ab5",fillOpacity:0.6}),
    Plot.ruleY([1],{stroke:"#c44536",strokeWidth:2,strokeDasharray:"5,4"})
  ]
})
html`<div class="book-applet-panel">
  ${pUniformPlot}
  <div class="book-applet-summary">
    <span>20 000 опытов для калибровки</span>
    <span>${pUniformCount} проверяемых опытов</span>
    <span>Доля p ≤ 0.05: ${(pUniformValues.filter(p=>p<=0.05).length/pUniformCount).toFixed(4)}</span>
    <span>p = (k + 1)/(20 000 + 1)</span>
  </div>
</div>`
