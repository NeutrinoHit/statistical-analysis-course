viewof pars = Inputs.form({
  mu: Inputs.range([-5, 5], {value: 0.8, step: 0.1, label: "μ"}),
  sigma: Inputs.range([0.2, 5], {value: 1.5, step: 0.1, label: "σ"}),
  seed: Inputs.range([1, 1000], {value: 123, step: 1, label: "начальное состояние"})
})

muTrue = pars.mu
sigmaTrue = pars.sigma
seed = pars.seed
N = 10

mulberry32 = function(a) {
  return function() {
    let t = a += 0x6D2B79F5
    t = Math.imul(t ^ t >>> 15, t | 1)
    t ^= t + Math.imul(t ^ t >>> 7, t | 61)
    return ((t ^ t >>> 14) >>> 0) / 4294967296
  }
}

normal01 = function(rng) {
  const u1 = Math.max(rng(), 1e-12)
  const u2 = rng()
  return Math.sqrt(-2 * Math.log(u1)) * Math.cos(2 * Math.PI * u2)
}

rng = mulberry32(seed)
X = Array.from({length: N}, () => muTrue + sigmaTrue * normal01(rng))
xbar = X.reduce((a, b) => a + b, 0) / N
shat2 = X.map(x => (x - xbar) ** 2).reduce((a, b) => a + b, 0) / (N - 1)
shat = Math.sqrt(shat2)
varMeanHat = shat2 / N
sigmaMeanHat = shat / Math.sqrt(N)
varSHat = shat2 / (2 * (N - 1))
sigmaSHat = shat / Math.sqrt(2 * (N - 1))
fmt = x => Number(x).toFixed(3)

html`
<div class="book-applet-data">
  <div class="book-applet-grid">
    <div class="book-applet-table-wrap">
      <table class="book-applet-table">
        <thead><tr><th>k</th><th>X_k</th><th>X_k - X̄</th><th>(X_k - X̄)^2</th></tr></thead>
        <tbody>
          ${X.map((x, i) => html`<tr><td>${i + 1}</td><td>${fmt(x)}</td><td>${fmt(x - xbar)}</td><td>${fmt((x - xbar) ** 2)}</td></tr>`)}
        </tbody>
      </table>
    </div>
    <div class="book-applet-results">
      <div>Истинные параметры: μ = ${fmt(muTrue)}, σ = ${fmt(sigmaTrue)}, N = ${N}</div>
      <div class="book-applet-result"><div>Оценка среднего:</div><div>X̄ = ${fmt(xbar)}</div></div>
      <div class="book-applet-result"><div>Оценки дисперсии и стандартного отклонения:</div><div>σ̂² = ${fmt(shat2)}</div><div>σ̂ = ${fmt(shat)}</div></div>
      <div class="book-applet-result"><div>Неопределённость среднего:</div><div>σ̂ / √N = ${fmt(sigmaMeanHat)}</div><div>оценка Var(X̄) = ${fmt(varMeanHat)}</div></div>
      <div class="book-applet-result"><div>Неопределённость оценки σ̂:</div><div>σ̂ / √[2(N−1)] = ${fmt(sigmaSHat)}</div><div>оценка Var(σ̂) ≈ ${fmt(varSHat)}</div></div>
    </div>
  </div>
</div>
`
